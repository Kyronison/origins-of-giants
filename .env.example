# Copy to .env and fill only the services you intend to use.
# Keep comments on separate lines. Never commit the resulting .env.
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
FAL_KEY=
PEXELS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
YOUTUBE_CLIENT_SECRET_FILE=data/youtube_client_secret.json

CHANNEL_NAME=Origins of Giants
DATA_DIR=data
MUSIC_DIR=data/music
RENDER_TMP=data/render_tmp
RENDER_HEIGHT=1080

# Review-first local configuration. Production scheduling is opt-in.
UPLOAD_MODE=manual
REQUIRE_FINAL_APPROVAL=1
AUTO_APPROVE=0
AUTO_SCRIPT_APPROVE=0
AUTO_PIPELINE=0
AUTO_BACKLOG=0
ES_AUTO=0
ES_CARTOON=0
ES_CARTOON_UPLOAD=0
SHORTS_PER_VIDEO=0
STRICT_GATES=1
QC_SHIP_ANYWAY=0
FINAL_RETENTION=off

# Choose currently available models in your provider accounts.
# Other model and generation settings are documented in orchestrator/config.py.
AI_BROLL_MAX_CLIPS=0
MUSIC_GENERATE=0
BUDGET_USD=10
SPEND_VIDEO_LIMIT=10
SPEND_MONTH_LIMIT=50
